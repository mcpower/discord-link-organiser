{
  "name": "girls",
  "version": "0.0.1",
  "description": "discord link organiser",
  "license": "MIT",
  "author": "mcpower",
  "type": "module",
  "main": "build/index.js",
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning --loader ts-node/esm index.ts",
    "startProd": "tsc && node ./build/index.js",
    "debug": "node --no-warnings=ExperimentalWarning --loader ts-node/esm --inspect index.ts",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "test": "vitest"
  },
  "dependencies": {
    "@mikro-orm/core": "^7.0.12",
    "@mikro-orm/decorators": "^7.0.12",
    "@mikro-orm/migrations": "^7.0.12",
    "@mikro-orm/reflection": "^7.0.12",
    "@mikro-orm/sqlite": "^7.0.12",
    "discord.js": "~14.26.3",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^7.0.12",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.12.2",
    "@vitest/coverage-v8": "^4.1.4",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "oxlint-tsgolint": "^0.22.0",
    "reflect-metadata": "^0.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": "24"
  },
  "mikro-orm": {
    "useTsNode": true,
    "configPaths": [
      "./src/orm.config.ts",
      "./build/src/orm.config.js"
    ]
  }
}
